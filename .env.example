# SQLite directory. Railway volume mounts here.
HAILMAP_DATA_DIR=/data

# Optional. When set, /api/income refreshes the bundled ACS county cache.
CENSUS_API_KEY=

# Optional GeoJSON (points or polygons) of MRMS MESH hail. Stub source; confidence "mesh".
HAILMAP_MESH_URL=

# Required in production for spotter and community webhooks.
HAILMAP_WEBHOOK_SECRET=

# Contact string sent as the NWS API User-Agent.
HAILMAP_USER_AGENT=HailMap/1.0 (https://github.com/diamondstatepdr/hailmap)

# HTTPS origin of the deployed web app. Release Android WebView loads only this URL.
# Example after Railway deploy: https://hailmap-production.up.railway.app
CAPACITOR_SERVER_URL=
